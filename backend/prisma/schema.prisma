// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Lấy đường dẫn DB từ file .env, nếu không có thì nó tự tạo file dev.db
  url      = env("DATABASE_URL") 
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Mật khẩu đã được mã hóa
  role      String   @default("CUSTOMER") // Role: "CUSTOMER", "STAFF", "ADMIN"
  name      String?
  phone     String?
  
  bookings  Booking[]
  shifts    Shift[]  // Dành cho Staff quản lý ca làm
}

model Movie {
  id          String   @id @default(uuid())
  title       String
  description String?
  posterUrl   String?
  trailerUrl  String?
  duration    Int      // Tính bằng Phút
  releaseDate DateTime
  status      String   // Trạng thái: "NOW_SHOWING", "COMING_SOON"
  
  showtimes   Showtime[]
}

model Room {
  id       String   @id @default(uuid())
  name     String   // Tên phòng chiếu: "Phòng 1", "Phòng IMAX"
  capacity Int      // Sức chứa
  
  seats    Seat[]
  showtimes Showtime[]
}

model Seat {
  id       String   @id @default(uuid())
  roomId   String
  room     Room     @relation(fields: [roomId], references: [id])
  row      String   // Hàng ghế: "A", "B", "C"...
  number   Int      // Số ghế: 1, 2, 3...
  type     String   // Loại ghế: "STANDARD", "VIP", "SWEETBOX"
  
  tickets  Ticket[]
}

model Showtime {
  id        String   @id @default(uuid())
  movieId   String
  roomId    String
  startTime DateTime
  endTime   DateTime
  priceBase Float    // Giá vé cơ bản
  
  movie     Movie    @relation(fields: [movieId], references: [id])
  room      Room     @relation(fields: [roomId], references: [id])
  tickets   Ticket[]
}

model Booking {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  totalAmount   Float    // Tổng tiền thanh toán
  status        String   // Trạng thái: "PENDING", "COMPLETED", "CANCELLED", "REFUNDED"
  paymentMethod String   // Cách trả tiền: "MOMO", "VNPAY", "CREDIT_CARD"
  createdAt     DateTime @default(now())
  
  tickets       Ticket[]
  comboItems    BookingCombo[]
}

model Ticket {
  id         String   @id @default(uuid())
  bookingId  String
  showtimeId String
  seatId     String
  price      Float    // Giá vé thực tế (đã cộng phụ thu VIP nếu có)
  status     String   // Trạng thái vé: "VALID", "USED", "REFUNDED"
  
  booking    Booking  @relation(fields: [bookingId], references: [id])
  showtime   Showtime @relation(fields: [showtimeId], references: [id])
  seat       Seat     @relation(fields: [seatId], references: [id])

  // Quan trọng: Đảm bảo 1 ghế trong 1 suất chiếu không thể bị mua 2 lần
  @@unique([showtimeId, seatId]) 
}

model Combo {
  id       String   @id @default(uuid())
  name     String   // Tên combo: "Combo 1 Bắp 2 Nước"
  price    Float
  image    String?
  stock    Int      @default(0) // Số lượng tồn kho
  
  bookings BookingCombo[]
}

model BookingCombo {
  bookingId String
  comboId   String
  quantity  Int      // Số lượng mua
  
  booking   Booking @relation(fields: [bookingId], references: [id])
  combo     Combo   @relation(fields: [comboId], references: [id])

  @@id([bookingId, comboId])
}

model Shift {
  id        String   @id @default(uuid())
  staffId   String
  startTime DateTime
  endTime   DateTime?
  cashStart Float    // Tiền lẻ đầu ca
  cashEnd   Float?   // Tiền mặt chốt ca
  
  staff     User     @relation(fields: [staffId], references: [id])
}
model Promotion {
  id        String   @id @default(uuid())
  title     String   // Tên KM: "Tuesday Special"
  desc      String   // Mô tả: "Giảm 50% thứ 3..."
  cta       String   @default("Get Deal") // Chữ trên nút bấm
  icon      String   @default("Ticket")   // Tên icon: "Ticket", "Gift", "Tag"...
  color     String   @default("#e8192c")  // Màu sắc của thẻ
  isActive  Boolean  @default(true)       // Bật/tắt khuyến mãi
}