generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String   
  role      String    @default("CUSTOMER") 
  name      String?
  phone     String?
  
  bookings  Booking[]
  shifts    Shift[]  
}

model Movie {
  id          String     @id @default(uuid())
  title       String
  description String?
  posterUrl   String?
  trailerUrl  String?
  duration    Int      
  releaseDate DateTime
  status      String   
  
  showtimes   Showtime[]
}

model Room {
  id       String     @id @default(uuid())
  name     String   
  capacity Int      
  
  seats    Seat[]
  showtimes Showtime[]
}

model Seat {
  id       String   @id @default(uuid())
  roomId   String
  row      String   
  number   Int      
  type     String   
  
  // Xóa Phòng thì tự động bay màu Ghế
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tickets  Ticket[]
}

model Showtime {
  id        String    @id @default(uuid())
  movieId   String
  roomId    String
  startTime DateTime
  endTime   DateTime
  priceBase Float    
  
  // Xóa Phim hoặc Phòng thì Suất Chiếu cũng bay màu
  movie     Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tickets   Ticket[]
}

model Booking {
  id            String         @id @default(uuid())
  userId        String
  totalAmount   Float    
  status        String   
  paymentMethod String   
  createdAt     DateTime       @default(now())
  
  // Xóa User thì tự động xóa luôn Lịch sử Booking của người đó
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tickets       Ticket[]
  comboItems    BookingCombo[]
}

model Ticket {
  id         String   @id @default(uuid())
  bookingId  String
  showtimeId String
  seatId     String
  price      Float    
  status     String   
  
  // Xóa Hóa Đơn, Suất Chiếu hoặc Ghế thì Vé cũng tự hủy
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  showtime   Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seat       Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@unique([showtimeId, seatId]) 
}

model Combo {
  id       String         @id @default(uuid())
  name     String   
  price    Float
  image    String?
  stock    Int            @default(0) 
  
  bookings BookingCombo[]
}

model BookingCombo {
  bookingId String
  comboId   String
  quantity  Int      
  
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  combo     Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)

  @@id([bookingId, comboId])
}

model Shift {
  id        String    @id @default(uuid())
  staffId   String
  startTime DateTime
  endTime   DateTime?
  cashStart Float    
  cashEnd   Float?

  staff     User      @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model Promotion {
  id        String   @id @default(uuid())
  title     String   
  desc      String   
  cta       String   @default("Get Deal") 
  icon      String   @default("Ticket")   
  color     String   @default("#e8192c")  
  isActive  Boolean  @default(true)       
  
  code          String   @unique @default(uuid())
  discountType  String   @default("PERCENT")
  discountValue Int      @default(0)
  minOrderValue Int      @default(0)
}